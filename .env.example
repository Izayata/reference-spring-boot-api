# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# Gmail App Password for Spring Mail (smtp.gmail.com)
EMAIL_PASSWORD=your_google_app_password_here

# Gmail sender address for Spring Mail
MAIL_USERNAME=your_gmail_address@gmail.com

# PostgreSQL credentials
DB_PASSWORD=your_db_password_here
DB_USERNAME=your_db_username_here

# Frontend URL (used for CORS and password-reset links)
APP_FRONTEND_URL=your_app_frontend_url

# Password reset token settings
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=3
PASSWORD_RESET_CLEANUP_RATE_MS=3600000

# Redis host (localhost when running outside Docker)
REDIS_HOST=localhost

# Local bootRun overrides (only needed when running ./gradlew bootRun against Docker-hosted services)
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/restaurant
